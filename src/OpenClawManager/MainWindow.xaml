<Window x:Class="OpenClawManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenClaw Manager" Width="1180" Height="760" MinWidth="980" MinHeight="650"
        Icon="Assets/OpenClawManagerLogo.png"
        Background="{StaticResource WindowBackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Grid.RowSpan="2" Background="#14171D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="112" /><RowDefinition Height="*" /><RowDefinition Height="74" /></Grid.RowDefinitions>
                <Grid Margin="24,22,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="44" Height="44" CornerRadius="10" Background="#0B0E14"><Image Source="Assets/OpenClawManagerLogo.png" Stretch="Uniform" /></Border><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="OPENCLAW" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Manager" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0" /><TextBlock Text="Installer &amp; control center" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" /></StackPanel></Grid>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <Button Style="{StaticResource NavButtonStyle}" Click="Overview_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" /><TextBlock Text="概览" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="Install_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" /><TextBlock Text="安装与配置" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="Gateway_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" /><TextBlock Text="Gateway" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="Diagnostics_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" /><TextBlock Text="诊断中心" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="Model_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" /><TextBlock Text="模型与备份" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="Logs_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" /><TextBlock Text="运行日志" /></StackPanel></Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="Uninstall_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" /><TextBlock Text="安全卸载" /></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="24,0,20,22"><TextBlock Text="v0.2.0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /><TextBlock Text="Windows 10 / 11 x64" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="30,0,30,0">
                <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitleText" Text="概览" FontSize="22" FontWeight="SemiBold" /><TextBlock x:Name="PageSubtitleText" Text="查看本机 OpenClaw 安装与服务状态" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="#20352C" CornerRadius="14" Padding="11,6" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="HeaderStatusDot" Width="7" Height="7" Fill="{StaticResource WarningBrush}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock x:Name="HeaderStatusText" Text="正在检测" FontSize="12" /></StackPanel></Border><TextBlock Text="本地管理模式" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" /></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="30,26,30,28">
            <Grid x:Name="OverviewPage">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="#1A2742" CornerRadius="12" Padding="24" Margin="0,0,0,20"><Grid><StackPanel><TextBlock Text="OpenClaw 本机控制中心" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="安装一次，之后从这里启动、停止、修复和备份。" Foreground="#B6C4DF" Margin="0,8,0,0" /><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Style="{StaticResource PrimaryButtonStyle}" Content="开始安装" Click="Install_Click" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="运行修复" Click="Repair_Click" Margin="10,0,0,0" /></StackPanel></StackPanel><TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="72" Foreground="#6C91F5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0" /></Grid></Border>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="OpenClaw" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="OpenClawVersionText" Text="未安装" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,2" /><TextBlock x:Name="OpenClawPathText" Text="等待检测" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="5,0,5,0"><StackPanel><TextBlock Text="Node.js" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="NodeVersionText" Text="未检测" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,2" /><TextBlock x:Name="NodePathText" Text="需要 22.22.3+ / 24.15+" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /></StackPanel></Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="10,0,0,0"><StackPanel><TextBlock Text="Gateway" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="GatewayStatusText" Text="未检测" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,2" /><TextBlock Text="默认端口 18789" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /></StackPanel></Border>
                </UniformGrid>
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20"><StackPanel><TextBlock Text="快速操作" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="只会操作由本管理器确认过的 OpenClaw 资源，不会清理未知配置。" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,18" /><WrapPanel><Button Style="{StaticResource SecondaryButtonStyle}" Content="刷新状态" Click="Refresh_Click" Margin="0,0,10,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="启动 Gateway" Click="StartGateway_Click" Margin="0,0,10,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="停止 Gateway" Click="StopGateway_Click" Margin="0,0,10,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="打开配置目录" Click="OpenConfig_Click" /></WrapPanel></StackPanel></Border>
            </Grid>

            <Grid x:Name="InstallPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,18"><StackPanel><TextBlock Text="安装向导" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="在线下载并校验 Node.js，然后安装 OpenClaw CLI 和 Gateway。" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" /><ProgressBar x:Name="InstallProgressBar" Height="7" Margin="0,20,0,8" Minimum="0" Maximum="100" Value="0" /><TextBlock x:Name="InstallProgressText" Text="准备就绪" Foreground="{StaticResource MutedTextBrush}" FontSize="12" /></StackPanel></Border>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,9,0">
                        <StackPanel>
                            <TextBlock Text="安装选项" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="先选择安装范围，再开始安装。已有兼容环境会自动复用。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,16" />
                            <CheckBox x:Name="InstallNodeCheckBox" IsChecked="True" Content="Node.js 不兼容时自动安装" />
                            <CheckBox x:Name="InstallGatewayCheckBox" IsChecked="True" Content="安装并启动 Gateway" />
                            <CheckBox x:Name="ConfigureModelCheckBox" IsChecked="False" Content="同时配置模型 API" Checked="ConfigureModelCheckBox_Changed" Unchecked="ConfigureModelCheckBox_Changed" />
                            <Border Background="#202A3A" CornerRadius="7" Padding="12" Margin="0,16,0,0">
                                <TextBlock Text="安装 Node.js 可能会弹出 UAC 授权。网络中断或取消授权时，软件会保留失败原因，不会静默继续。" TextWrapping="Wrap" Foreground="#C8D5EC" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="9,0,0,0">
                        <StackPanel>
                            <TextBlock Text="模型配置" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="ModelConfigurationHintText" Text="先勾选左侧“同时配置模型 API”，这里的内容才会在安装时写入 OpenClaw。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,16" />
                            <StackPanel x:Name="ModelConfigurationPanel" IsEnabled="False">
                                <TextBlock Text="服务商" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox x:Name="ProviderCombo" SelectionChanged="Provider_SelectionChanged" ToolTip="选择 OpenClaw 使用的模型服务商">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="模型 ID" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,6" />
                                <TextBox x:Name="ModelIdBox" ToolTip="例如：gpt-4.1-mini；留空则使用服务商默认值" />
                                <TextBlock Text="API Key" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,6" />
                                <PasswordBox x:Name="ApiKeyBox" ToolTip="只用于本次配置，不会写入运行日志" />
                                <TextBlock x:Name="BaseUrlLabel" Text="Base URL（自定义服务商）" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,6" Visibility="Collapsed" />
                                <TextBox x:Name="BaseUrlBox" ToolTip="例如：https://api.example.com/v1" Visibility="Collapsed" />
                            </StackPanel>
                            <WrapPanel Margin="0,22,0,0"><Button x:Name="InstallButton" Style="{StaticResource PrimaryButtonStyle}" Content="安装 OpenClaw" Click="RunInstall_Click" /><Button x:Name="CancelInstallButton" Style="{StaticResource SecondaryButtonStyle}" Content="取消安装" Click="CancelInstall_Click" IsEnabled="False" Margin="10,0,0,0" /></WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="GatewayPage" Visibility="Collapsed"><StackPanel><Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,18"><Grid><StackPanel><TextBlock Text="Gateway 服务" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="管理本机服务生命周期，不默认开放局域网访问。" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" /><TextBlock x:Name="GatewayDetailText" Text="正在读取状态" Margin="0,24,0,0" /></StackPanel><TextBlock x:Name="GatewayLargeStatusText" Text="未检测" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border><Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22"><StackPanel><TextBlock Text="服务操作" FontSize="16" FontWeight="SemiBold" /><WrapPanel Margin="0,20,0,0"><Button Style="{StaticResource PrimaryButtonStyle}" Content="启动" Click="StartGateway_Click" Margin="0,0,10,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="停止" Click="StopGateway_Click" Margin="0,0,10,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="重启" Click="RestartGateway_Click" Margin="0,0,10,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="刷新" Click="Refresh_Click" /></WrapPanel></StackPanel></Border></StackPanel></Grid>

            <Grid x:Name="DiagnosticsPage" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="诊断中心" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="重新检测环境、配置、Gateway 和模型服务。不会导出 API Key 或原始 .openclaw 配置。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                        <WrapPanel Margin="0,20,0,0">
                            <Button x:Name="RunDiagnosticsButton" Style="{StaticResource PrimaryButtonStyle}" Content="运行完整诊断" Click="RunDiagnostics_Click" Margin="0,0,10,0" />
                            <Button x:Name="ExportDiagnosticsButton" Style="{StaticResource SecondaryButtonStyle}" Content="导出诊断包" Click="ExportDiagnostics_Click" IsEnabled="False" />
                        </WrapPanel>
                        <TextBlock x:Name="DiagnosticsSummaryText" Text="尚未运行诊断" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <ListView x:Name="DiagnosticsList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="检查项" DisplayMemberBinding="{Binding Name}" Width="150" />
                                <GridViewColumn Header="结果" DisplayMemberBinding="{Binding StatusText}" Width="70" />
                                <GridViewColumn Header="说明" DisplayMemberBinding="{Binding Summary}" Width="500" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>

            <Grid x:Name="ModelPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,18"><StackPanel><TextBlock Text="配置备份" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="备份包含 .openclaw 目录内容，恢复时保留备份清单文件。" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" /><WrapPanel Margin="0,20,0,0"><Button Style="{StaticResource PrimaryButtonStyle}" Content="立即备份" Click="Backup_Click" Margin="0,0,10,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="恢复选中备份" Click="Restore_Click" /></WrapPanel></StackPanel></Border><Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22"><StackPanel><TextBlock Text="历史备份" FontSize="16" FontWeight="SemiBold" /><ComboBox x:Name="BackupCombo" DisplayMemberPath="Path" Margin="0,16,0,0" /><TextBlock x:Name="BackupStatusText" Text="尚无备份" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0" /></StackPanel></Border></Grid>

            <Grid x:Name="LogsPage" Visibility="Collapsed"><Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="运行日志" FontSize="20" FontWeight="SemiBold" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="清空视图" Click="ClearLogs_Click" Margin="20,0,0,0" /></StackPanel><ListBox x:Name="LogList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedTextBrush}" Margin="0,18,0,0" /></Grid></Border></Grid>

            <Grid x:Name="UninstallPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="#38252A" BorderBrush="#6A3942" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,0,18"><StackPanel><TextBlock Text="安全卸载" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="只卸载由管理器记录为自有的资源；配置和工作区默认保留。" Foreground="#E6B9BF" TextWrapping="Wrap" Margin="0,8,0,0" /><TextBlock x:Name="UninstallPreviewText" Text="点击预览以读取当前资源归属。" Foreground="#F0D2D5" TextWrapping="Wrap" Margin="0,18,0,0" /></StackPanel></Border><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,9,0"><StackPanel><TextBlock Text="清理选项" FontSize="16" FontWeight="SemiBold" /><CheckBox x:Name="RemoveGatewayCheckBox" Content="卸载由管理器安装的 Gateway" Margin="0,20,0,0" /><CheckBox x:Name="RemoveOpenClawCheckBox" Content="卸载由管理器安装的 OpenClaw CLI" /><CheckBox x:Name="RemoveNodeCheckBox" Content="卸载由管理器安装的 Node.js" /><CheckBox x:Name="RemoveConfigCheckBox" Content="删除 .openclaw 配置（会先备份）" /><CheckBox x:Name="RemoveWorkspaceCheckBox" Content="删除 .openclaw/workspace" /><CheckBox x:Name="RemoveManagerDataCheckBox" Content="删除管理器日志和备份" /></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="9,0,0,0"><StackPanel><TextBlock Text="执行卸载" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="未勾选的资源不会被删除。环境变量不会被管理器主动清理。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,18,0,0" /><WrapPanel Margin="0,24,0,0"><Button Style="{StaticResource SecondaryButtonStyle}" Content="预览资源" Click="PreviewUninstall_Click" Margin="0,0,10,0" /><Button Style="{StaticResource PrimaryButtonStyle}" Content="执行选中操作" Click="RunUninstall_Click" /></WrapPanel><TextBlock x:Name="UninstallStatusText" Text="等待操作" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,20,0,0" /></StackPanel></Border></Grid></Grid>
        </Grid>
    </Grid>
</Window>
